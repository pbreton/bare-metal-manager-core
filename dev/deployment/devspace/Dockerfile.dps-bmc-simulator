# Adapted from cmd/dps-bmc-simulator/Dockerfile in the internally pinned DPS
# 0.8.0 source checkout. Keep this provenance note when updating DPS.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a

ARG BINARY_ARCH
COPY --chown=nonroot:nonroot target/dist/dps-bmc-simulator-config.yaml /app/config.yaml
COPY --chown=nonroot:nonroot target/dist/dps-bmc-simulator-mockups /app/mockups
COPY --chown=root:root --chmod=0755 \
    target/dist/dps-bmc-simulator_linux_${BINARY_ARCH}/dps-bmc-simulator /app/dps-bmc-simulator

WORKDIR /app
USER nonroot
EXPOSE 8443
ENTRYPOINT ["/app/dps-bmc-simulator", "-c", "/app/config.yaml"]
